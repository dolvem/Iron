root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# D50: ktlint con code style android. En ktlint 1.x el valor es android_studio.
ktlint_code_style = android_studio
max_line_length = 120
# Los composables se nombran en PascalCase por convención de Compose.
ktlint_function_naming_ignore_when_annotated_with = Composable
